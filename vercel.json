{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend-admin/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "frontend-driver/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/frontend-admin/$1"
    },
    {
      "src": "/driver/(.*)",
      "dest": "/frontend-driver/$1"
    },
    {
      "src": "/admin",
      "dest": "/frontend-admin/index.html"
    },
    {
      "src": "/driver",
      "dest": "/frontend-driver/index.html"
    },
    {
      "src": "/",
      "dest": "/frontend-admin/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}


