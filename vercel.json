{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/frontend-admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/frontend-admin/$1"
    },
    {
      "source": "/driver",
      "destination": "/frontend-driver/index.html"
    },
    {
      "source": "/driver/(.*)",
      "destination": "/frontend-driver/$1"
    },
    {
      "source": "/",
      "destination": "/frontend-admin/index.html"
    }
  ]
}
